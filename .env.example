# Copy this file's variable names into Vercel: Project Settings ->
# Environment Variables. Do not commit real values to the repo.

# Brevo v3 API key (Brevo dashboard: SMTP & API -> API Keys)
BREVO_API_KEY=

# Numeric ID of the "First Look Photo - Playbook Leads" list
# (open the list in Brevo, the ID is in the URL)
BREVO_PLAYBOOK_LIST_ID=
